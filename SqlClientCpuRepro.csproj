<Project Sdk="Microsoft.NET.Sdk">

  <!-- One program, built for both runtimes, measuring process CPU time per SqlClient query.
       Pick the SqlClient version with -p:SqlClientVersion=... (default 7.1.1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <SqlClientVersion Condition="'$(SqlClientVersion)' == ''">7.1.1</SqlClientVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="$(SqlClientVersion)" />
    <!-- not used directly: SqlClient 7.1.1 asks for 9.0.18, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
